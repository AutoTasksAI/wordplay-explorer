# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Parent newsletter (EmailOctopus) - set the real values in the Keys tab
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=

# OTP verification email sender (Resend) - required for public auth
# The repo currently uses Freebuff's OTP service; swap to Resend before launch.
RESEND_API_KEY=
EMAIL_FROM=
